import { AboutSlint, Button, ComboBox, LineEdit, Switch, SpinBox, StandardTableView, ListView, ScrollView, Palette } from "std-widgets.slint";

export struct General {
    default-mode: int,      // 0 中文 1 英文
    punctuation: int,       // 0 全形 1 半形
    output: int,            // 0 繁體 1 簡體
    on-focus: int,          // 0 記住 1 重設
    shift: int,             // 0 左右 1 左 2 右 3 關
    tap-ms: int,
    per-page: int,
    sort-freq: bool,
    detect-legacy: bool,
    detect-fullscreen: bool,
    auto-english: bool,
    english-candidate: bool,
    auto-space: bool,
    primary: int,           // 主要符號：0 ` + 鍵 1 右 Alt + 鍵 2 兩種都可以
    secondary: int,         // 次要符號：0 Shift + 鍵 1 ` / 右 Alt + Shift + 鍵
}

export struct AiSettings {
    enabled: bool,
    endpoint: string,
    model: string,
    timeout: int,
}

export struct SyncSettings {
    enabled: bool,
    remote: string,
    interval: int,
}

export struct Hotkeys {
    width: string,
    output: string,
    game: string,
    forget: string,
    pin: string,
    emoji: string,
    ai: string,
    bar: string,
    symbols: string,
}

export struct Theme {
    layout: int,            // 0 直式 1 橫式
    font: string,
    size: int,
    background: string,
    text: string,
    number: string,
    highlight: string,
}

// 0 = 沿用全域設定
export struct AppRuleRow {
    name: string,
    windows: string,
    macos: string,
    default-mode: int,      // 0 / 1 中文 / 2 英文
    punctuation: int,       // 0 / 1 全形 / 2 半形
    output: int,            // 0 / 1 繁體 / 2 簡體
    on-focus: int,          // 0 / 1 記住 / 2 重設
    game: int,              // 0 關 / 1 鎖定英文 / 2 保留狀態
    detect: int,            // 0 / 1 開 / 2 關
    bar: int,               // 組字提示列：0 沿用 / 1 開 / 2 關
}

export struct Phrase {
    word: string,
    bopomofo: string,
    state: int,             // 0 一般 / 1 優先 / 2 封鎖
    abbrev: bool,           // 縮寫（讀音是英文字母）：沒有狀態，只能移除
}

export struct Day {
    label: string,
    chars: int,
    corrections: int,
    accuracy: float,        // 0–1
}

component Row inherits HorizontalLayout {
    in property <string> label;
    spacing: 12px;
    alignment: start;
    Text {
        text: root.label;
        width: 140px;
        vertical-alignment: center;
    }
    @children
}

/// 說明文字（自動換行、淡色）
component Help inherits Text {
    wrap: word-wrap;
    font-size: 12px;
    color: Palette.foreground.with-alpha(0.6);
}

/// 欄位下方的說明：與欄位的輸入框對齊（標題寬 140 + 間距 12）
component Note inherits HorizontalLayout {
    in property <string> text;
    padding-left: 152px;
    Help { text: root.text; horizontal-stretch: 1; }
}

component Section inherits Text {
    font-size: 18px;
    font-weight: 600;
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 36px;
    border-radius: 6px;
    background: root.active ? Palette.selection-background : touch.has-hover ? Palette.alternate-background : transparent;
    Text {
        x: 14px;
        text: root.text;
        vertical-alignment: center;
        color: root.active ? Palette.selection-foreground : Palette.foreground;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Preview inherits Rectangle {
    in property <Theme> theme;
    in property <color> bg;
    in property <color> fg;
    in property <color> num;
    in property <color> hl;
    property <[string]> words: ["天", "添", "田", "填", "甜"];
    background: root.bg;
    border-radius: 8px;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000040;
    width: root.theme.layout == 0 ? vlist.preferred-width : hlist.preferred-width;
    height: root.theme.layout == 0 ? vlist.preferred-height : hlist.preferred-height;

    vlist := VerticalLayout {
        visible: root.theme.layout == 0;
        padding: 4px;
        for w[i] in root.words: Rectangle {
            border-radius: 4px;
            background: i == 1 ? root.hl : transparent;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 10px;
                padding-top: 2px;
                padding-bottom: 2px;
                spacing: 8px;
                Text { text: i + 1; color: root.num; font-family: root.theme.font; font-size: root.theme.size * 0.75px; vertical-alignment: center; }
                Text { text: w; color: root.fg; font-family: root.theme.font; font-size: root.theme.size * 1px; }
            }
        }
    }
    hlist := HorizontalLayout {
        visible: root.theme.layout == 1;
        padding: 4px;
        for w[i] in root.words: Rectangle {
            border-radius: 4px;
            background: i == 1 ? root.hl : transparent;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                padding-top: 2px;
                padding-bottom: 2px;
                spacing: 4px;
                Text { text: i + 1; color: root.num; font-family: root.theme.font; font-size: root.theme.size * 0.75px; vertical-alignment: center; }
                Text { text: w; color: root.fg; font-family: root.theme.font; font-size: root.theme.size * 1px; }
            }
        }
    }
}

component ColorField inherits HorizontalLayout {
    in-out property <string> value;
    in property <color> swatch;
    spacing: 8px;
    LineEdit {
        width: 110px;
        text <=> root.value;
    }
    Rectangle {
        width: 24px;
        height: 24px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Palette.border;
        background: root.swatch;
    }
}

export component SettingsWindow inherits Window {
    title: "動物園輸入法 設定";
    preferred-width: 820px;
    preferred-height: 600px;
    default-font-family: "Microsoft JhengHei UI";

    in-out property <int> page: 0;
    in-out property <General> general;
    in-out property <Hotkeys> hotkeys;
    in-out property <Theme> theme;
    in property <[AppRuleRow]> apps;
    in-out property <int> app-index: -1;
    in-out property <AppRuleRow> app-edit;
    in property <[Phrase]> phrases;
    in property <[Day]> days;
    in property <string> summary;
    in property <[string]> backups;
    in-out property <string> restore-pending;
    in property <string> status;
    in-out property <SyncSettings> sync;
    in-out property <AiSettings> ai;
    in property <bool> has-api-key;
    in property <string> ai-status;
    in property <string> sync-status;
    in property <bool> online;
    in property <string> version;
    in property <string> data-path;
    // 用 ZCT_HOME 環境變數指定資料位置時不能在這裡變更
    in property <bool> data-path-locked;
    // 詞庫：正在編輯的那一筆（加入欄位改成更新它）
    in-out property <bool> phrase-editing;
    in-out property <Phrase> phrase-edit;

    pure callback parse-color(string) -> color;
    pure callback hotkey-valid(string) -> bool;
    callback save();
    callback select-app(int);
    callback apply-app();
    callback add-app();
    callback remove-app(int);
    callback filter-phrases(string);
    callback add-phrase(string, string);
    callback phrase-state(Phrase, int);
    callback remove-phrase(Phrase);
    callback update-phrase(Phrase, string, string);
    pure callback suggest-reading(string) -> string;
    callback restore(string);
    callback refresh();
    callback sync-now();
    callback save-api-key(string);
    callback test-ai();
    callback change-data-root();

    HorizontalLayout {
        // 側邊導覽
        Rectangle {
            width: 160px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                alignment: start;
                NavItem { text: "一般"; active: root.page == 0; clicked => { root.page = 0; } }
                NavItem { text: "快捷鍵"; active: root.page == 1; clicked => { root.page = 1; } }
                NavItem { text: "外觀"; active: root.page == 2; clicked => { root.page = 2; } }
                NavItem { text: "App 規則"; active: root.page == 3; clicked => { root.page = 3; } }
                NavItem { text: "詞庫"; active: root.page == 4; clicked => { root.page = 4; root.refresh(); } }
                NavItem { text: "學習"; active: root.page == 5; clicked => { root.page = 5; root.refresh(); } }
                NavItem { text: "同步"; active: root.page == 6; clicked => { root.page = 6; root.refresh(); } }
                NavItem { text: "AI"; active: root.page == 7; clicked => { root.page = 7; } }
                NavItem { text: "關於"; active: root.page == 8; clicked => { root.page = 8; } }
            }
        }

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            // ---- 一般 ----
            if root.page == 0: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 10px;
                    alignment: start;
                    Section { text: "輸入"; }
                    Row { label: "預設模式"; ComboBox { width: 160px; model: ["中文", "英文"]; current-index <=> root.general.default-mode; } }
                    Note { text: "新開 App 時的中英狀態。"; }
                    Row { label: "標點"; ComboBox { width: 160px; model: ["全形", "半形"]; current-index <=> root.general.punctuation; } }
                    Note { text: "全形（，。？）或半形（,.?），所有 App 共用。"; }
                    Row { label: "主要符號"; ComboBox { width: 280px; model: ["` + 鍵", "右 Alt + 鍵", "` + 鍵 或 右 Alt + 鍵"]; current-index <=> root.general.primary; } }
                    Note { text: "鍵帽下排的字元：` 再按 , → ，、` 再按 1 → １、` 按兩下 → `。用右 Alt 時，App 收不到右 Alt 組合鍵。"; }
                    Row { label: "次要符號"; ComboBox { width: 280px; model: ["Shift + 鍵", "` 或 右 Alt + Shift + 鍵"]; current-index <=> root.general.secondary; } }
                    Note { text: "鍵帽上排的符號：Shift + , → ＜、Shift + ' → ＂。選第二種時，Shift + 鍵改打中文標點（，。；「」）。"; }
                    Row { label: "輸出"; ComboBox { width: 160px; model: ["繁體", "簡體"]; current-index <=> root.general.output; } }
                    Note { text: "組字區與候選窗一律顯示繁體，送出時才轉成簡體。"; }
                    Row { label: "切回 App 時"; ComboBox { width: 160px; model: ["保留中英狀態", "重設為預設模式"]; current-index <=> root.general.on-focus; } }
                    Section { text: "Shift 切換中英"; }
                    Help { text: "單按 Shift 切換中英。組字中切換不會送出，接著打的英文和數字加進組字區：第 Shift 6 Shift 章 → 第6章。"; }
                    Row { label: "使用的 Shift"; ComboBox { width: 160px; model: ["左右都可", "左 Shift", "右 Shift", "不使用"]; current-index <=> root.general.shift; } }
                    Row { label: "按住上限（毫秒）"; SpinBox { width: 160px; minimum: 100; maximum: 1000; step-size: 50; value <=> root.general.tap-ms; } }
                    Note { text: "按住超過這個時間才放開，不算切換。"; }
                    Section { text: "候選字"; }
                    Row { label: "每頁字數"; SpinBox { width: 160px; minimum: 1; maximum: 10; value <=> root.general.per-page; } }
                    Row { label: "依常用程度排序"; Switch { checked <=> root.general.sort-freq; } }
                    Note { text: "常用字在前，並參考你的選字紀錄。"; }
                    Section { text: "不在打字時不處理按鍵"; }
                    Help { text: "偵測到不是在打字（遊戲、全螢幕影片）時，按鍵直接交給 App，Shift 也不切換中英。下面兩項判斷誤判時可以關掉。"; }
                    Row { label: "舊式程式全螢幕"; Switch { checked <=> root.general.detect-legacy; } }
                    Note { text: "沒有文字游標、又蓋滿整個螢幕的舊式程式，例如 DirectX 遊戲。"; }
                    Row { label: "獨佔全螢幕"; Switch { checked <=> root.general.detect-fullscreen; } }
                    Note { text: "全螢幕遊戲、簡報播放。視窗模式的遊戲偵測不到，請用遊戲模式。"; }
                    Section { text: "中英混打"; }
                    Row { label: "自動判斷英文單字"; Switch { checked <=> root.general.auto-english; } }
                    Note { text: "句首或空白後打英文單字再按空白，就當作英文（hello、repo）。用 Shift 打過的英文會記住。"; }
                    Row { label: "候選窗附上英文"; Switch { checked <=> root.general.english-candidate; } }
                    Note { text: "按鍵也是英文單字時，候選窗多一個英文選項：fu → 七、fu。"; }
                    Row { label: "中英之間自動空格"; Switch { checked <=> root.general.auto-space; } }
                    Note { text: "中文與英文、數字之間加一個空格。"; }
                }
            }

            // ---- 快捷鍵 ----
            if root.page == 1: ScrollView {
              vertical-stretch: 1;
              VerticalLayout {
                spacing: 10px;
                alignment: start;
                Section { text: "快捷鍵"; }
                Help { text: "格式例如 ctrl+shift+f12、shift+space，留空代表不使用。沒設定的 Ctrl / Alt 組合鍵照常交給 App。"; }
                for item in [
                    { label: "全形 / 半形", idx: 0, help: "切換標點的全形與半形。" },
                    { label: "繁體 / 簡體", idx: 1, help: "切換送出的文字是繁體或簡體。" },
                    { label: "遊戲模式", idx: 2, help: "按鍵全部交給 App，Shift 不切換中英；再按一次關閉。" },
                    { label: "忘記學習", idx: 3, help: "候選窗中：忘記選擇框那個詞的學習紀錄與優先。游標在英文單字上：不再當英文。" },
                    { label: "設為優先", idx: 4, help: "候選窗中：選擇框那個詞以後都排第一。" },
                    { label: "Emoji", idx: 5, help: "用組字內容找 Emoji；沒有組字時列出常用 Emoji。" },
                    { label: "AI 修正", idx: 6, help: "用 AI 修正組字中的同音錯字。" },
                    { label: "組字提示列", idx: 7, help: "在游標上方顯示組字內容，給看不到組字的 App（終端機）用；每個 App 分別記住。" },
                    { label: "符號選單", idx: 8, help: "…、※、括號、希臘字母、數學符號。" },
                ]: VerticalLayout {
                  spacing: 2px;
                  Row {
                    label: item.label;
                    property <string> value: item.idx == 0 ? root.hotkeys.width : item.idx == 1 ? root.hotkeys.output : item.idx == 2 ? root.hotkeys.game : item.idx == 3 ? root.hotkeys.forget : item.idx == 4 ? root.hotkeys.pin : item.idx == 5 ? root.hotkeys.emoji : item.idx == 6 ? root.hotkeys.ai : item.idx == 7 ? root.hotkeys.bar : root.hotkeys.symbols;
                    LineEdit {
                        width: 220px;
                        text: parent.value;
                        placeholder-text: "未設定";
                        edited(t) => {
                            if item.idx == 0 { root.hotkeys.width = t; }
                            if item.idx == 1 { root.hotkeys.output = t; }
                            if item.idx == 2 { root.hotkeys.game = t; }
                            if item.idx == 3 { root.hotkeys.forget = t; }
                            if item.idx == 4 { root.hotkeys.pin = t; }
                            if item.idx == 5 { root.hotkeys.emoji = t; }
                            if item.idx == 6 { root.hotkeys.ai = t; }
                            if item.idx == 7 { root.hotkeys.bar = t; }
                            if item.idx == 8 { root.hotkeys.symbols = t; }
                        }
                    }
                    Text {
                        vertical-alignment: center;
                        color: #d13438;
                        text: root.hotkey-valid(parent.value) ? "" : "格式錯誤";
                    }
                  }
                  Note { text: item.help; }
                }
              }
            }

            // ---- 外觀 ----
            if root.page == 2: HorizontalLayout {
                vertical-stretch: 1;
                spacing: 48px;
                alignment: start;
                VerticalLayout {
                    spacing: 10px;
                    alignment: start;
                    Section { text: "候選窗"; }
                    Row { label: "排列"; ComboBox { width: 160px; model: ["直式", "橫式"]; current-index <=> root.theme.layout; } }
                    Row { label: "字型"; LineEdit { width: 200px; text <=> root.theme.font; } }
                    Row { label: "字級"; SpinBox { width: 160px; minimum: 8; maximum: 48; value <=> root.theme.size; } }
                    Row { label: "背景"; ColorField { value <=> root.theme.background; swatch: root.parse-color(root.theme.background); } }
                    Row { label: "文字"; ColorField { value <=> root.theme.text; swatch: root.parse-color(root.theme.text); } }
                    Row { label: "數字"; ColorField { value <=> root.theme.number; swatch: root.parse-color(root.theme.number); } }
                    Row { label: "選擇框"; ColorField { value <=> root.theme.highlight; swatch: root.parse-color(root.theme.highlight); } }
                }
                VerticalLayout {
                    alignment: start;
                    padding-top: 40px;
                    Preview {
                        theme: root.theme;
                        bg: root.parse-color(root.theme.background);
                        fg: root.parse-color(root.theme.text);
                        num: root.parse-color(root.theme.number);
                        hl: root.parse-color(root.theme.highlight);
                    }
                }
            }

            // ---- App 規則 ----
            if root.page == 3: VerticalLayout {
                vertical-stretch: 1;
                spacing: 10px;
                Help { text: "對個別 App 覆寫設定。執行檔名稱在工作管理員的「詳細資料」分頁。"; }
                StandardTableView {
                    min-height: 160px;
                    columns: [{ title: "名稱" }, { title: "Windows" }, { title: "macOS" }];
                    rows: root.apps-rows;
                    current-row <=> root.app-index;
                    current-row-changed(i) => { root.select-app(i); }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button { text: "新增"; clicked => { root.add-app(); } }
                    Button { text: "刪除"; enabled: root.app-index >= 0; clicked => { root.remove-app(root.app-index); } }
                }
                if root.app-index >= 0: VerticalLayout {
                    spacing: 8px;
                    Row { label: "名稱"; LineEdit { width: 220px; text <=> root.app-edit.name; accepted => { root.apply-app(); } } }
                    Row { label: "Windows 執行檔"; LineEdit { width: 220px; text <=> root.app-edit.windows; placeholder-text: "Code.exe"; accepted => { root.apply-app(); } } }
                    Row { label: "macOS Bundle ID"; LineEdit { width: 220px; text <=> root.app-edit.macos; placeholder-text: "com.microsoft.VSCode"; accepted => { root.apply-app(); } } }
                    Row { label: "預設模式"; ComboBox { width: 160px; model: ["沿用全域", "中文", "英文"]; current-index <=> root.app-edit.default-mode; } }
                    Row { label: "標點"; ComboBox { width: 160px; model: ["沿用全域", "全形", "半形"]; current-index <=> root.app-edit.punctuation; } }
                    Row { label: "輸出"; ComboBox { width: 160px; model: ["沿用全域", "繁體", "簡體"]; current-index <=> root.app-edit.output; } }
                    Row { label: "遊戲模式"; ComboBox { width: 160px; model: ["關", "鎖定英文", "保留中英狀態"]; current-index <=> root.app-edit.game; } }
                    Note { text: "鎖定英文：按鍵全部交給 App。保留中英狀態：可以打中文，但 Shift 不切換中英，適合遊戲聊天室。"; }
                    Row { label: "自動偵測"; ComboBox { width: 160px; model: ["沿用全域", "開", "關"]; current-index <=> root.app-edit.detect; } }
                    Note { text: "輸入框卻打不了中文時選「關」。"; }
                    Row { label: "組字提示列"; ComboBox { width: 160px; model: ["沿用全域", "開", "關"]; current-index <=> root.app-edit.bar; } }
                    HorizontalLayout { alignment: start; Button { text: "套用"; clicked => { root.apply-app(); } } }
                }
            }

            // ---- 詞庫 ----
            if root.page == 4: VerticalLayout {
                vertical-stretch: 1;
                spacing: 10px;
                Help { text: "讀音填注音是自訂詞，填英文字母是縮寫：打縮寫再按空白就換成詞。優先：一律排第一；封鎖：不出現在候選；移除：恢復預設。在組字區按 Shift + ← / → 選範圍再按 Enter 也能加詞。"; }
                form := HorizontalLayout {
                    spacing: 8px;
                    property <bool> ready: root.online && word.text != "" && reading.text != "";
                    function submit() {
                        if !self.ready { return; }
                        if root.phrase-editing {
                            root.update-phrase(root.phrase-edit, word.text, reading.text);
                        } else {
                            root.add-phrase(word.text, reading.text);
                        }
                        self.clear();
                    }
                    function clear() {
                        root.phrase-editing = false;
                        word.text = "";
                        reading.text = "";
                        word.focus();
                    }
                    public function edit(p: Phrase) {
                        root.phrase-edit = p;
                        root.phrase-editing = true;
                        word.text = p.word;
                        reading.text = p.bopomofo;
                        word.focus();
                    }
                    word := LineEdit {
                        width: 160px;
                        placeholder-text: "詞";
                        // 打中文時填入最常用的讀音
                        edited(t) => { reading.text = root.suggest-reading(t); }
                        accepted => { reading.focus(); }
                    }
                    reading := LineEdit {
                        width: 220px;
                        placeholder-text: "注音或縮寫";
                        accepted => { form.submit(); }
                    }
                    Button {
                        text: root.phrase-editing ? "更新" : "加入";
                        enabled: form.ready;
                        clicked => { form.submit(); }
                    }
                    if root.phrase-editing: Button { text: "取消"; clicked => { form.clear(); } }
                    Rectangle { }
                    LineEdit { width: 180px; placeholder-text: "搜尋"; edited(t) => { root.filter-phrases(t); } }
                }
                ListView {
                    for p in root.phrases: HorizontalLayout {
                        height: 38px;
                        spacing: 12px;
                        padding-left: 4px;
                        alignment: start;
                        Text { width: 120px; text: p.word; vertical-alignment: center; color: p.state == 2 ? Palette.foreground.with-alpha(0.4) : Palette.foreground; }
                        Text { width: 200px; text: p.bopomofo; vertical-alignment: center; color: Palette.foreground.with-alpha(0.7); }
                        if p.abbrev: Text { width: 110px; text: "縮寫"; vertical-alignment: center; color: Palette.foreground.with-alpha(0.7); }
                        if !p.abbrev: ComboBox {
                            width: 110px;
                            model: ["一般", "優先", "封鎖"];
                            current-index: p.state;
                            selected => { root.phrase-state(p, self.current-index); }
                        }
                        Button { text: "編輯"; enabled: root.online; clicked => { form.edit(p); } }
                        Button { text: "移除"; enabled: root.online; clicked => { root.remove-phrase(p); } }
                    }
                }
            }

            // ---- 學習 ----
            if root.page == 5: VerticalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                alignment: start;
                Section { text: "首選正確率（近 30 天）"; }
                Help { text: "不必選字就打對的比例。在候選窗改選的字，同一個修正送出兩次後會記住；學錯了在候選窗按忘記學習快捷鍵。"; }
                Text { text: root.summary; }
                Rectangle {
                    height: 160px;
                    border-width: 1px;
                    border-color: Palette.border;
                    border-radius: 6px;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 4px;
                        alignment: start;
                        for d in root.days: VerticalLayout {
                            width: 14px;
                            alignment: end;
                            Rectangle {
                                height: max(2px, d.accuracy * 130px);
                                border-radius: 2px;
                                background: d.accuracy >= 0.95 ? #2b9348 : d.accuracy >= 0.85 ? #e09f3e : #d13438;
                                TouchArea { }
                            }
                        }
                    }
                }
                Section { text: "從備份還原"; }
                Text {
                    text: "把學習紀錄還原到之前某一天。";
                    color: Palette.foreground.with-alpha(0.6);
                }
                for day in root.backups: HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { width: 120px; text: day; vertical-alignment: center; }
                    Button {
                        text: root.restore-pending == day ? "確定還原？" : "還原";
                        enabled: root.online;
                        clicked => {
                            if root.restore-pending == day {
                                root.restore(day);
                            } else {
                                root.restore-pending = day;
                            }
                        }
                    }
                }
            }

            // ---- 同步 ----
            if root.page == 6: VerticalLayout {
                vertical-stretch: 1;
                spacing: 10px;
                alignment: start;
                Section { text: "資料位置"; }
                Help { text: "設定、App 規則、詞庫與學習紀錄都存在這裡。重灌後選同一個資料夾就能恢復；多台電腦請用 git 同步，不要共用雲端資料夾。"; }
                Row {
                    label: "目前位置";
                    Text { text: root.data-path; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                }
                Row {
                    label: "";
                    Button { text: "變更位置…"; enabled: !root.data-path-locked; clicked => { root.change-data-root(); } }
                }
                Note { text: root.data-path-locked ? "由 ZCT_HOME 環境變數指定。" : "選空的資料夾會把目前的資料複製過去；選已有資料的資料夾會直接改用它。原本的資料會保留。"; }
                Section { text: "git 同步"; }
                Text {
                    text: "同步設定、App 規則、詞庫與統計；學習紀錄不同步。請用私人 repo。";
                    color: Palette.foreground.with-alpha(0.6);
                    wrap: word-wrap;
                }
                Row { label: "自動同步"; Switch { checked <=> root.sync.enabled; } }
                Row { label: "遠端 repo"; LineEdit { width: 360px; text <=> root.sync.remote; placeholder-text: "git@github.com:you/zoo-type-data.git"; } }
                Row { label: "間隔（分鐘）"; SpinBox { width: 160px; minimum: 1; maximum: 1440; value <=> root.sync.interval; } }
                HorizontalLayout {
                    alignment: start;
                    spacing: 12px;
                    Button { text: "立即同步"; enabled: root.online; clicked => { root.sync-now(); } }
                    Button { text: "重新整理狀態"; clicked => { root.refresh(); } }
                }
                Text { text: root.sync-status; wrap: word-wrap; }
            }

            // ---- AI ----
            if root.page == 7: VerticalLayout {
                vertical-stretch: 1;
                spacing: 10px;
                alignment: start;
                Section { text: "AI 同音字修正"; }
                Text {
                    text: "按 AI 修正快捷鍵（目前：" + (root.hotkeys.ai == "" ? "未設定" : root.hotkeys.ai) + "）修正組字中的同音錯字，結果出現在候選窗。\n只在按快捷鍵時傳送；端點不在本機時，打字內容會離開這台電腦。";
                    color: Palette.foreground.with-alpha(0.6);
                    wrap: word-wrap;
                }
                Row { label: "啟用"; Switch { checked <=> root.ai.enabled; } }
                Row { label: "端點（OpenAI 相容）"; LineEdit { width: 360px; text <=> root.ai.endpoint; placeholder-text: "http://localhost:11434/v1"; } }
                Row { label: "模型"; LineEdit { width: 240px; text <=> root.ai.model; placeholder-text: "qwen3.5:2b"; } }
                Row { label: "逾時（秒）"; SpinBox { width: 160px; minimum: 1; maximum: 120; value <=> root.ai.timeout; } }
                Row {
                    label: "API Key";
                    key := LineEdit { width: 240px; input-type: password; placeholder-text: root.has-api-key ? "已儲存" : "本機服務可以留空"; accepted => { if self.text != "" { root.save-api-key(self.text); self.text = ""; } } }
                    Button { text: "儲存金鑰"; enabled: key.text != ""; clicked => { root.save-api-key(key.text); key.text = ""; } }
                    Button { text: "清除"; enabled: root.has-api-key; clicked => { root.save-api-key(""); } }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 12px;
                    Button { text: "測試連線"; clicked => { root.test-ai(); } }
                }
                Text { text: root.ai-status; wrap: word-wrap; }
            }

            // ---- 關於 ----
            if root.page == 8: ScrollView {
              vertical-stretch: 1;
              VerticalLayout {
                spacing: 10px;
                alignment: start;
                Section { text: "動物園輸入法"; }
                Text { text: "版本 " + root.version; }
                Help { text: "注音輸入法，以 MIT 或 Apache-2.0 授權。\n原始碼與問題回報：https://github.com/zoosewu/zoo-type"; }
                Section { text: "第三方元件"; }
                Help { text: "libchewing：注音轉換引擎（LGPL-2.1-or-later）\nlibchewing-data：詞庫（LGPL-2.1-or-later）與語言模型（CC-BY-4.0）\nOpenCC：繁簡轉換字表（Apache-2.0）\nUnicode CLDR：Emoji 中文關鍵字（Unicode-3.0）\ndwyl/english-words：英文單字表（Unlicense）\nSlint：設定程式介面\n完整清單見安裝資料夾中的 THIRD-PARTY-NOTICES.txt"; }
                // Slint 授權（Royalty-free 2.0）要求在「關於」畫面顯示；限制大小，不要佔滿畫面
                HorizontalLayout { alignment: start; AboutSlint { max-width: 260px; max-height: 140px; } }
              }
            }

            // 底部狀態列
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: root.online ? root.status : "輸入法服務未執行，無法使用詞庫與學習";
                    vertical-alignment: center;
                    color: root.online ? Palette.foreground.with-alpha(0.7) : #d13438;
                }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "儲存設定"; primary: true; clicked => { root.save(); } }
            }
        }
    }

    // App 規則表格的列（由 apps 推導）
    in property <[[StandardListViewItem]]> apps-rows;
}
